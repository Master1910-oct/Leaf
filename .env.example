# AgriAI Environment Variables Template
# Copy this file to .env and fill in values before running any code
# NEVER commit the actual .env file to version control

# ─────────────────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=5000

# ─────────────────────────────────────────────────────────
# PATHS
# ─────────────────────────────────────────────────────────
DATA_ROOT=./data
EXPERIMENTS_ROOT=./experiments
MODELS_DIR=./models

# ─────────────────────────────────────────────────────────
# DATASET
# ─────────────────────────────────────────────────────────
PLANTVILLAGE_PATH=./data/raw/plantvillage
SPLITS_DIR=./data/splits

# ─────────────────────────────────────────────────────────
# FLASK API
# ─────────────────────────────────────────────────────────
FLASK_SECRET_KEY=replace_with_a_strong_random_secret_key
FLASK_ENV=development
MAX_CONTENT_LENGTH=16777216

# ─────────────────────────────────────────────────────────
# MODEL
# ─────────────────────────────────────────────────────────
MODEL_CHECKPOINT_PATH=./models/best_model.pth
CALIBRATION_TEMPERATURE=1.0

# ─────────────────────────────────────────────────────────
# OPTIONAL — ONNX / EDGE DEPLOYMENT
# ─────────────────────────────────────────────────────────
ONNX_MODEL_PATH=./models/model.onnx

# ─────────────────────────────────────────────────────────
# OPTIONAL — IoT INTEGRATION
# ─────────────────────────────────────────────────────────
IOT_BROKER_HOST=
IOT_BROKER_PORT=1883
IOT_TOPIC_PREFIX=agri_ai
