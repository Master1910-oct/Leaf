@"
# ============================================================
# Leaf — Smart Farming / LS-HGNet Project
# Git ignore rules
# ============================================================

# -------------------------
# Python
# -------------------------
__pycache__/
*.py[cod]
*.pyd
*.pyo
*.egg
*.egg-info/
.Python
.pytest_cache/
.tox/
.mypy_cache/
.dmypy.json
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/

# -------------------------
# Virtual environments
# -------------------------
.venv/
venv/
env/
ENV/
.env/
*.env

# -------------------------
# IDE / OS
# -------------------------
.vscode/
.idea/
*.suo
*.user
.DS_Store
Thumbs.db
desktop.ini

# -------------------------
# Node.js
# -------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity

# -------------------------
# Frontend build outputs
# -------------------------
frontend/build/
frontend/dist/

# -------------------------
# Raw / processed datasets
# -------------------------
data/raw/
data/processed/
datasets/
test_data/
*.csv.gz

# -------------------------
# Large trained model files
# -------------------------
*.pt
*.pth
*.onnx
*.bin
*.safetensors

# -------------------------
# Experiment checkpoints
# -------------------------
experiments/*/checkpoints/
experiments/*/logs/
results/**/checkpoints/

# -------------------------
# Large / generated result artifacts
# -------------------------
results/**/predictions/
results/**/cache/
results/**/tmp/

# -------------------------
# Training logs
# -------------------------
*.log
logs/
*.tfevents.*

# -------------------------
# Temporary / scratch work
# -------------------------
scratch/
scratch_*.txt
*.tmp
*.bak
*.swp
*~

# -------------------------
# Build / packaging
# -------------------------
dist/
build/
eggs/
parts/
sdist/
wheels/
.installed.cfg

# -------------------------
# Jupyter
# -------------------------
.ipynb_checkpoints/

# -------------------------
# Local secrets
# -------------------------
.env
.env.*
!.env.example
"@ | Set-Content .gitignore